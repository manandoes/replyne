# Copy to .env.local and fill in. Never commit real secrets.

# Postgres (docker-compose maps the container to host port 5433)
DATABASE_URL=postgresql://replyline:replyline@localhost:5433/replyline

# Public base URL of this app (used for the extension connect link and same-origin checks)
APP_URL=http://localhost:3000

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_TRUST_HOST=true

# AI provider: "gemini" or "mock". Without a key, development falls back to the
# clearly labeled mock; production refuses to generate until configured.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Hours to keep Reddit text captured by users before it is purged (Reddit recommends <= 48)
CAPTURED_TEXT_RETENTION_HOURS=48

# Bearer secret for /api/jobs/* (call POST /api/jobs/purge-expired at least hourly)
CRON_SECRET=

# Reddit Data API — Phase 4, gated. Leave empty until Reddit grants written
# commercial approval (see docs/compliance.md). Nothing reads Reddit while empty.
REDDIT_DATA_API_APPROVAL_REF=
